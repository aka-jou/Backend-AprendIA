# Configuración de Servidor
APP_PORT=8080
SERVER_CONTEXT_PATH=/api

# Configuración de Base de Datos (PostgreSQL pgvector)
# ADVERTENCIA: Cambiar estas credenciales en producción
DB_USERNAME=aprendia_app
DB_PASSWORD=Apr3nd1A_DB_!S3cur3Pa$$2026
DB_NAME=aprendiadb
DB_PORT_EXT=5432

# Configuración de Seguridad y JWT
# El secreto de JWT debe tener al menos 256 bits (32 caracteres) para algoritmos HS256
JWT_SECRET=aprendia_super_secret_jwt_key_2026_secure_algorithm_for_signatures
JWT_EXPIRATION=86400000  # 24 horas en milisegundos

# Configuración de Encriptación de Datos de la Aplicación
ENCRYPTION_SECRET=aprendia_encryption_secret_key_2026

# Configuración CORS (orígenes permitidos separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Configuración de Logs (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SECURITY=INFO
LOGGING_LEVEL_SQL=WARN

# Correo SMTP (envío del código OTP de inicio de sesión)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@aprendia.local

# SOLO desarrollo local sin SMTP: true escribe el código OTP en el log (NUNCA en producción)
OTP_MOCK_DELIVERY=false
