# Configuración de Servidor
APP_PORT=8080
SERVER_CONTEXT_PATH=/api

# Configuración de Base de Datos (PostgreSQL pgvector)
# Obligatoria: sin DB_PASSWORD la aplicación y docker-compose no arrancan.
# Genere una con: openssl rand -base64 24
DB_USERNAME=aprendia_app
DB_PASSWORD=CAMBIAR_POR_UNA_CONTRASENA_ALEATORIA
DB_NAME=aprendiadb
DB_PORT_EXT=5432

# Configuración de Seguridad y JWT
# Obligatorio. Mínimo 256 bits (32 caracteres) para HS256. Genere uno con: openssl rand -base64 48
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_48_BYTES
JWT_EXPIRATION=86400000  # 24 horas en milisegundos

# Configuración de Encriptación de Datos de la Aplicación
# Obligatorio. Genere uno con: openssl rand -base64 48
# No lo cambie una vez que hay datos: los campos cifrados dejarían de poder leerse.
ENCRYPTION_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_48_BYTES

# Configuración CORS (orígenes permitidos separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# Configuración de Logs (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL_APP=INFO
LOGGING_LEVEL_SECURITY=INFO
LOGGING_LEVEL_SQL=WARN

# Correo SMTP (envío del código OTP de inicio de sesión)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@aprendia.local

# SOLO desarrollo local sin SMTP: true escribe el código OTP en el log (NUNCA en producción)
OTP_MOCK_DELIVERY=false

# Rotación automática de API keys: "-" la desactiva. Al activarla, las keys vigentes quedan obsoletas
# y la nueva se envía por Firebase Cloud Messaging (requiere firebase-service-account.json).
API_KEY_ROTATION_CRON=-
